<%# app/views/application/log-book.html.erb %>
<% content_for :title, "Log Book" %>

<div class="container mt-4">
  <%= form_tag log_book_path, method: :post, class: 'mb-4' do %>
    <!-- Remplacement de input-group par des marges pour un meilleur rendu vertical -->
    <div class="mb-3">
      <%= text_area_tag :entry, nil, class: 'form-control',
                         placeholder: 'Write your entry...', required: true, rows: 5 %>
    </div>
    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
      <%= submit_tag 'Write', class: 'btn btn-warning text-white font-weight-bold' %>
    </div>
  <% end %>

  <% (@entries || []).each do |entry| %>
    <p class="entry border-bottom py-2"><%= entry %></p>
  <% end %>
</div>
